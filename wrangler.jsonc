{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pingtungpark",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
