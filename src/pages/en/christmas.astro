---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const site = Astro.site ?? new URL('https://pingtungpark.com');
const canonical = new URL('/en/christmas', site).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pingtung Park', item: new URL('/en/', site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Pingtung Christmas', item: canonical }
  ]
};

const faqs = [
  { q: 'Where is Pingtung Christmas held?', a: 'Pingtung Christmas is an important winter festival in Pingtung City each year; the area around Pingtung Park often features festive lights and atmosphere. Exact location and scope are subject to official announcements.' },
  { q: 'What time are the Pingtung Park Christmas lights on?', a: 'Lights usually turn on after dusk; actual lighting and off times follow the annual plan. Check the latest official announcement before going; this page does not hard-code fixed times.' },
  { q: 'When is Pingtung Christmas (date)?', a: 'The event mostly falls in winter each year (around December); exact schedule and yearly arrangement follow the authority and official social announcements.' },
  { q: 'Is Pingtung Park Christmas good for photos?', a: 'Night lights and festive decor are great for photos; for framing and light tips see the Photography & Best Times page.' },
  { q: 'How to plan for crowds and transport?', a: 'Popular times and weekends draw bigger crowds; arrive early, prefer public transport or mind parking. See the Transport & Parking page.' },
  { q: 'Is it good to bring kids?', a: 'Lights and festive atmosphere suit family visits; flat paths and seating are friendlier. Details in the Family-Friendly Facilities page.' }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } }))
};
---
<BaseLayout
  title="Pingtung Christmas | Pingtung Park Lights, Decor & Best Photo Times — Pingtung Park"
  description="Pingtung Christmas (Pingtung Park) page: festive lights highlights, best photo times after dusk, crowd and transport tips, family visit and nearby add-on suggestions, with where to check exact dates."
  keywords="Pingtung Christmas, Pingtung Park Christmas, Pingtung Christmas lights, Pingtung Park lantern festival, Pingtung Xmas, Pingtung Park Xmas, Pingtung Christmas events, Pingtung Park Christmas photo"
  canonicalPath="/en/christmas"
  locale="en"
  ogImageAlt="Pingtung Park (Pingtung Park) — Pingtung Christmas lights"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-[#173226]/55">
        <a href="/en/" class="hover:text-[#b6533d]">Home</a>
        <span class="mx-1">→</span><a href="/en/events" class="hover:text-[#b6533d]">Events</a>
        <span class="mx-1">→</span><span class="text-[#b6533d]">Pingtung Christmas</span>
      </nav>
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#b6533d]/20 bg-white/70 px-4 py-2 text-xs font-bold tracking-[.18em] text-[#b6533d]">CHRISTMAS</div>
      <h1 class="serif text-5xl font-black leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">Pingtung <span class="text-[#b6533d]">Christmas</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#173226]/75">Every winter, <strong>Pingtung Christmas</strong> lights up the festive atmosphere of Pingtung City, and the area around Pingtung Park often features lights and decor. This page compiles <strong>light highlights, best photo times, crowd and transport tips, and family visit</strong> suggestions; exact dates, locations and lighting times are subject to official announcements.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-4 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-3xl border border-[#173226]/10 bg-white/75 p-6 leaf-card">
        <p class="text-xs font-black tracking-[.15em] text-[#b6533d]">LIGHTS</p>
        <h2 class="serif mt-3 text-xl font-black">Festive lights</h2>
        <p class="mt-3 text-sm leading-7 text-[#173226]/70">After dusk, the park and surroundings often feature Christmas lights, themed decor and light installations — a popular highlight for winter strolls and check-ins.</p>
      </article>
      <article class="rounded-3xl border border-[#173226]/10 bg-white/75 p-6 leaf-card">
        <p class="text-xs font-black tracking-[.15em] text-[#6c7f4d]">PHOTO</p>
        <h2 class="serif mt-3 text-xl font-black">Night photography</h2>
        <p class="mt-3 text-sm leading-7 text-[#173226]/70">Lights are bright, good for handheld night shots; for framing and timing see the Photography & Best Times page.</p>
      </article>
      <article class="rounded-3xl border border-[#173226]/10 bg-white/75 p-6 leaf-card">
        <p class="text-xs font-black tracking-[.15em] text-[#d7a948]">FAMILY</p>
        <h2 class="serif mt-3 text-xl font-black">Family visit</h2>
        <p class="mt-3 text-sm leading-7 text-[#173226]/70">Flat paths and seating suit slow walks with kids; when crowded, avoid peaks and rest in batches.</p>
      </article>
    </div>
  </section>

  <section class="bg-[#173226] text-[#fffdf7]">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
      <p class="text-xs font-bold tracking-[.24em] text-[#d7a948]">PLAN YOUR VISIT</p>
      <h2 class="serif mt-3 text-4xl font-black sm:text-5xl">Crowd, transport & shooting tips</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {[
          'Popular times and weekends draw bigger crowds; arrive early or pick a non-holiday evening.',
          'Prefer public transport or mind nearby parking; see the Transport & Parking page.',
          'For night shots mind safety and others’ paths; use personal lighting if needed.',
          'Winter nights are cooler; bring an extra layer for kids and elderly.',
          'Exact lighting dates, locations and program follow official announcements.',
          'You can add the Martial Arts Hall, Victory Village and nearby food; see Nearby Attractions and Food Nearby.'
        ].map(tip => (
          <li class="flex gap-3 rounded-2xl bg-white/5 p-5 text-sm leading-7 text-white/85"><span class="font-black text-[#ffe5a9]">✓</span><span>{tip}</span></li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3 text-sm font-bold">
        <a href="/en/photo" class="rounded-full bg-white px-5 py-3 text-[#173226]">Photo times</a>
        <a href="/en/transport" class="rounded-full border border-white/50 px-5 py-3 text-white hover:bg-white/10">Transport & Parking</a>
        <a href="/en/attractions" class="rounded-full border border-white/50 px-5 py-3 text-white hover:bg-white/10">Nearby Attractions</a>
      </div>
    </div>
  </section>

  <section id="faq" class="mx-auto max-w-4xl px-5 py-16 lg:py-24">
    <p class="text-xs font-bold tracking-[.2em] text-[#b6533d]">FAQ</p>
    <h2 class="section-title serif mt-2 text-4xl font-black">Pingtung Christmas FAQ</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((item, i) => (
        <details class="group rounded-2xl border border-[#173226]/10 bg-white/75 p-5" open={i === 0}>
          <summary class="cursor-pointer list-none pr-8 font-black">{item.q}<span class="float-right text-[#b6533d] group-open:rotate-45">＋</span></summary>
          <p class="mt-4 text-sm leading-7 text-[#173226]/68">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
