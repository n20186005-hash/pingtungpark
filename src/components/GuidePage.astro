---
import BaseLayout from '../layouts/BaseLayout.astro';import guide from '../data/guide.json';
interface Props{page:keyof typeof guide;locale:'zh'|'en';}const {page,locale}=Astro.props;const en=locale==='en';const content=guide[page];const path=(en?'/en':'')+(page==='index'?'/':'/'+page);const canonical='https://pingtungpark.com'+path;const home=en?'/en/':'/';
const sources=[['https://www.i-pingtung.com/baby/ptpark','屏東旅遊網：遊戲場、交通及設施','Official tourism: playground, transport and facilities'],['https://www.amazing-pingtung.com/ptcm','2026屏東聖誕節主辦方公告','Organiser: 2026 Pingtung Christmas'],['https://tcmb.culture.tw/zh-tw/detail?id=11000001465&indexCode=MOCCOLLECTIONS','國家文化記憶庫：屏東公園','National Cultural Memory Bank: Pingtung Park'],['https://nchdb.boch.gov.tw/assets/overview/monument/19851127000082','國家文化資產網：阿猴城門','National heritage record: A-kau Gate'],['https://www.taiwan.net.tw/m1.aspx?id=A12-00501&sNo=0001016','觀光署：勝利星村','Tourism Administration: Victory Star Village']];
const schema=[{'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:content.title[locale],description:content.description[locale],inLanguage:en?'en':'zh-Hant',about:{'@id':'https://pingtungpark.com/#place'}},{'@context':'https://schema.org','@type':'FAQPage','@id':canonical+'#faq',mainEntity:content.faqs.map(f=>({'@type':'Question',name:f.q[locale],acceptedAnswer:{'@type':'Answer',text:f.a[locale]}}))}];
if(page==='index')schema.push({'@context':'https://schema.org','@type':'TouristAttraction','@id':'https://pingtungpark.com/#place',name:'屏東公園 / Pingtung Park',url:'https://pingtungpark.com/',description:guide.index.description[locale],address:{'@type':'PostalAddress',streetAddress:'公園路 / Gongyuan Road',addressLocality:'屏東市 / Pingtung City',addressRegion:'屏東縣 / Pingtung County',postalCode:'900',addressCountry:'TW'},hasMap:'https://maps.app.goo.gl/EDkUSZQMdvhaWmhK6'} as any);
---
<BaseLayout title={content.title[locale]} description={content.description[locale]} canonicalPath={path} locale={locale}>
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}/></Fragment>
<section class="hero container"><nav class="breadcrumb" aria-label={en?'Breadcrumb':'麵包屑'}><a href={home}>{en?'Home':'首頁'}</a> / {en?'Pingtung Park':'屏東公園'}</nav><p class="eyebrow">PINGTUNG PARK · {en?'INDEPENDENT GUIDE':'獨立參觀指南'}</p><h1 class="serif">{content.title[locale]}</h1><p class="intro">{content.description[locale]}</p><div class="actions"><a class="button" href="https://maps.app.goo.gl/EDkUSZQMdvhaWmhK6" target="_blank" rel="noopener noreferrer">{en?'Open place on Google Maps ↗':'在Google地圖確認地點 ↗'}</a><a class="button secondary" href="#sources">{en?'Sources & review date':'來源與查閱日期'}</a></div>
{page==='index'&&<><p class="snapshot">{en?'Google Maps: 4.4 / 5 · 14,021 reviews. Manually checked 2026-10-30; a dated snapshot that does not update automatically. Not reviews collected by this site.':'Google地圖：4.4 / 5星 · 14,021則評價。2026-10-30手工查閱的日期快照，不會自動更新；不是本站收集的評論。'}</p><figure><img src="/images/park-2025-1600.jpg" srcset="/images/park-2025-800.jpg 800w, /images/park-2025-1600.jpg 1600w" sizes="(max-width: 900px) 100vw, 1050px" width="1600" height="1205" fetchpriority="high" alt={en?'Red-roofed waterside pavilion and arched bridge, photographed in January 2025':'紅瓦池畔涼亭與拱橋，2025年1月拍攝'}/><figcaption>{en?'Historical photo, 4 January 2025 — not current conditions or event lighting.':'2025年1月4日歷史照片，不代表當前現況或活動燈飾。'} <a href="https://commons.wikimedia.org/wiki/File:Pingtung_Park,_Jan_2025_(1).jpg">Ralff Nestor Nacor / Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. {en?'Resized and recompressed; social image also cropped. Derivatives retain the same licence.':'已縮放、重新壓縮；社交圖另經裁切，衍生圖維持相同授權。'}</figcaption></figure></>}
</section>
<div class="container content-grid">{content.sections.map((s,i)=><section class="leaf-card text-card" id={'section-'+(i+1)}><p class="eyebrow">0{i+1}</p><h2 class="serif">{s.title[locale]}</h2><p>{s.body[locale]}</p></section>)}</div>
<section class="container faq" id="faq"><h2 class="serif">{en?'Questions before you go':'行前常見問題'}</h2>{content.faqs.map(f=><details><summary>{f.q[locale]}</summary><p>{f.a[locale]}</p></details>)}</section>
<section class="sources" id="sources"><div class="container"><h2 class="serif">{en?'Sources and scope':'資料來源與適用範圍'}</h2><p>{en?'Reviewed 2026-10-30. These sources cover different subjects; a date or facility statement is not transferred to a different venue. Recheck operational details before travel.':'2026-10-30查閱。各來源涵蓋不同主題，不把某項時段或設施資料套用到其他場地；營運資訊請在出發前重查。'}</p><ul>{sources.map(([url,zh,eng])=><li><a href={url} target="_blank" rel="noopener noreferrer">{en?eng:zh} ↗</a></li>)}<li><a href="https://www.cwa.gov.tw/" target="_blank" rel="noopener noreferrer">{en?'Central Weather Administration: forecasts and warnings':'中央氣象署：預報與警特報'} ↗</a></li></ul><p>{en?'Maps is a dated third-party snapshot; no individual reviews are reproduced. This site has no live weather feed. Consult official forecasts and warnings for your actual travel date.':'Maps是第三方日期快照，本站不轉載個別評論。本站沒有即時天氣資料，請另查實際出發日期的官方預報與警特報。'}</p><nav class="related" aria-label={en?'Related guides':'相關指南'}>{Object.entries(guide).filter(([key])=>key!==page).map(([key,item])=><a href={(en?'/en':'')+(key==='index'?'/':'/'+key)}>{item.title[locale]}</a>)}</nav></div></section>
</BaseLayout>
